# Clé Resend (https://resend.com/api-keys). Sans clé, le formulaire propose l'email et WhatsApp directement.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=haboudboukari15@gmail.com
# Expéditeur. En test : onboarding@resend.dev (n'envoie qu'à l'adresse du compte Resend).
# Après vérification du domaine : Portfolio <contact@haboudi.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Adresse publique du site (canoniques, sitemap, Open Graph). Sur Vercel, déduite automatiquement si vide.
NEXT_PUBLIC_SITE_URL=
# Google Search Console : code de la balise HTML de vérification (contenu de content="…"), facultatif.
GOOGLE_SITE_VERIFICATION=
